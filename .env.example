# =============================================================================
# GHS-TL (Ghana Health Service Training Library) environment.
# Copy to .env.local and fill in real values. Never commit .env*.local.
# Every variable below is read by code or by drizzle-kit.
#
# On Vercel these are set in Project → Settings → Environment Variables.
# vercel.json deliberately declares no `env` block.
# =============================================================================

# DATABASE — Neon serverless Postgres connection string
# Get it from Neon → Project → Settings → Connection string → Pooled connection
# Format: postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL="postgresql://<user>:<password>@<neon-host>.neon.tech/<dbname>?sslmode=require"

# Connections this process may open. Neon auto-scales, leave unset locally (5).
# On Vercel set 3: every warm function instance holds its own pool.
# DB_POOL_MAX=3

# SESSION — 32+ byte random string, signs the session cookie
SESSION_SECRET="replace-with-32-char-min-secret"

# APP
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional public contact details.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""

# SEED (local/staging only; the seeder refuses production unless ALLOW_PROD_SEED=true)
SEED_ADMIN_EMAIL="admin@ghs.gov.gh"
SEED_ADMIN_PASSWORD="change-me-12345"
ALLOW_PROD_SEED=false

# E2E (Playwright smoke tests; never commit real credentials)
E2E_LEARNER_EMAIL=""
E2E_LEARNER_PASSWORD="
