# =============================================================================
# GHS-TL (Ghana Health Service Training Library) environment.
# Copy to .env.local and fill in real values. Never commit .env*.local.
# Every variable below is read by code or by drizzle-kit (the CI workflow
# exits early when a required one is missing).
#
# On Vercel these are set in Project → Settings → Environment Variables.
# vercel.json deliberately declares no `env` block: secret *references*
# (@name) fail the build when the secret does not exist, and a fresh project
# starts with none.
# =============================================================================

# DATABASE — runtime pool (Supabase Transaction Pooler, port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (supabase session pooler, port 5432). Used ONLY by drizzle-kit.
# Take the exact string from Supabase → Connect → Session pooler: the username
# carries the project ref, and the host is aws-0-<region>.pooler.supabase.com.
# Do NOT use db.<project-ref>.supabase.co any more: it resolves to IPv6 only, so
# IPv4 networks (most of them) fail with "getaddrinfo ENOTFOUND". Do NOT use the
# 6543 transaction pooler here — DDL cannot run through it.
# Unsure? npm run db:doctor explains every mismatch without changing anything.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Connections this process may open. Leave unset locally (5). On Vercel set 3:
# every warm function instance holds its own pool, and the pooler's limit is per
# project, not per instance.
# DB_POOL_MAX=3

# SUPABASE — the browser needs the NEXT_PUBLIC_ pair; the anon key is public-safe.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Server-only. Bypasses RLS (file signing only). NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# APP
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional public contact details. When unset the site says how to reach ICT
# instead of inventing a phone number or address (see src/lib/site.ts).
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""

# SEED (local/staging only; the seeder refuses production unless ALLOW_PROD_SEED=true)
# There is no seeded password: provision staff logins with
#   npx tsx scripts/provision-auth-user.ts <email>
SEED_ADMIN_EMAIL="admin@ghs.gov.gh"
ALLOW_PROD_SEED=false

# E2E (Playwright smoke tests; never commit real credentials)
E2E_LEARNER_EMAIL=""
E2E_LEARNER_PASSWORD=""
