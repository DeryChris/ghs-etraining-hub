# =============================================================================
# GHS-ELN Environment — copy to .env and fill in real values. Never commit .env.
# Every variable below is actually read by the code (grep to verify).
# =============================================================================

# DATABASE — runtime pool (Supabase Transaction Pooler, port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (Session Pooler / db host, port 5432) — drizzle-kit only
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# SUPABASE — client code reads the NEXT_PUBLIC_ pair; keep anon key public-safe
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Server-only. Bypasses RLS. NEVER expose with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# APP
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SEED (local/staging only; seed refuses to run in production unless ALLOW_PROD_SEED=true)
SEED_ADMIN_EMAIL="admin@ghs.gov.gh"
SEED_ADMIN_PASSWORD="change-me-12345"
ALLOW_PROD_SEED=false
