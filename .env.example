# =============================================================================
# GHS-ELN Environment — copy to .env.local and fill in real values.
# Never commit .env*.local. Every variable below is read by code or by
# drizzle-kit (the CI workflow exits early when a required one is missing).
# =============================================================================

# DATABASE — runtime pool (Supabase Transaction Pooler, port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (session pooler / db host, port 5432).
# Used ONLY by drizzle-kit (generate/push/studio) via drizzle.config.ts.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# SUPABASE — the browser needs the NEXT_PUBLIC_ pair; the anon key is public-safe.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Server-only. Bypasses RLS (file signing only). NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# APP
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional public contact details. When unset the site says how to reach ICT
# instead of inventing a phone number or address (see src/lib/site.ts).
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""

# SEED (local/staging only; the seeder refuses production unless ALLOW_PROD_SEED=true)
# There is no seeded password: provision staff logins with
#   npx tsx scripts/provision-auth-user.ts <email>
SEED_ADMIN_EMAIL="admin@ghs.gov.gh"
ALLOW_PROD_SEED=false

# E2E (Playwright smoke tests; never commit real credentials)
E2E_LEARNER_EMAIL=""
E2E_LEARNER_PASSWORD=""
