# =============================================================================
# GHS-TL (Ghana Health Service Training Library) environment.
# Copy to .env.local and fill in real values. Never commit .env*.local.
# Every variable below is read by code or by drizzle-kit.
#
# On Vercel these are set in Project → Settings → Environment Variables.
# vercel.json deliberately declares no `env` block.
# =============================================================================

# DATABASE — Neon Postgres, two hosts for the same database
# Get both from Neon → Connect. The pooled host ends in `-pooler`.
# Format: postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require
#
# DATABASE_URL — the app. Pooled (PgBouncer): every serverless instance is a client.
DATABASE_URL="postgresql://<user>:<password>@ep-<name>-<id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
# DIRECT_URL — migrations and ops scripts only. Direct host: DDL cannot survive
# a transaction-mode pooler. Locally both can be the same URL.
DIRECT_URL="postgresql://<user>:<password>@ep-<name>-<id>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# Connections this process may open. Neon auto-scales, leave unset locally (5).
# On Vercel set 3: every warm function instance holds its own pool.
# DB_POOL_MAX=3

# OBJECT STORAGE — any S3-compatible bucket (Neon Object Storage by default).
# Get the keys from Neon → Object storage → Access keys, and create the bucket
# named below. Files are uploaded and downloaded by the browser through
# short-lived presigned URLs, so the bucket stays private and the keys never
# reach the browser. Without these three values material uploads are disabled
# and every other page still works.
S3_ENDPOINT="https://<bucket-endpoint>"
S3_REGION="eu-central-1"
S3_BUCKET="ghs-materials"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Path-style addressing is right for Neon/R2/MinIO; set false only for AWS S3.
# S3_FORCE_PATH_STYLE=true

# SESSION — 32+ byte random string, signs the session cookie
SESSION_SECRET="replace-with-32-char-min-secret"

# APP
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional public contact details.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""

# SEED (local/staging only; the seeder refuses production unless ALLOW_PROD_SEED=true)
SEED_ADMIN_EMAIL="admin@ghs.gov.gh"
SEED_ADMIN_PASSWORD="change-me-12345"
ALLOW_PROD_SEED=false

# E2E (Playwright smoke tests; never commit real credentials)
E2E_LEARNER_EMAIL=""
E2E_LEARNER_PASSWORD=""
