# =============================================================================
# GHS-ELN Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit real credentials
# =============================================================================

# DATABASE
# Pooled Connection (Supabase Transaction Pooler - Port 6543) for serverless runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?pgbouncer=true"
# Direct Connection (Supabase Session Pooler - Port 5432) for drizzle-kit migrations only
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres?sslmode=require"

# SESSION
# 32+ byte random string, rotates quarterly; signs the session cookie
SESSION_SECRET="replace-with-32-char-min-secret"

# SUPABASE (server-side only, never NEXT_PUBLIC_)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="sb_publishable_[...]"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_[...]"

# APP
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SEED (only for local/staging; refused in production unless ALLOW_PROD_SEED=true)
SEED_ADMIN_EMAIL="admin@ghs.gov.gh"
SEED_ADMIN_PASSWORD="change-me-12345"
ALLOW_PROD_SEED=false
