{
  "name": "ghs-uwrhd-training-library",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "GHS-UWRHD Training Library — institutional training materials for the Upper West Region, reviewed, versioned and audited.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node --conditions=react-server --import tsx src/db/seed.ts",
    "db:seed:geography": "node --conditions=react-server --import tsx scripts/seed-geography.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=1 next build",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test:e2e:public": "playwright test tests/e2e/public.spec.ts",
    "user:provision": "node --conditions=react-server --import tsx scripts/provision-auth-user.ts",
    "db:verify-chain": "node --conditions=react-server --import tsx scripts/verify-audit-chain.ts",
    "user:create-auth": "node --conditions=react-server --import tsx scripts/create-admin-auth.ts",
    "user:reset-password": "node --conditions=react-server --import tsx scripts/reset-admin-password.ts",
    "db:doctor": "node --conditions=react-server --import tsx scripts/db-doctor.ts",
    "db:check-chain": "node scripts/check-migration-chain.mjs",
    "staff:import": "node --conditions=react-server --import tsx scripts/import-staff.ts",
    "staff:sql": "node --conditions=react-server --import tsx scripts/export-staff-sql.ts",
    "db:repair": "node scripts/db-repair.mjs",
    "db:apply": "node scripts/apply-sql.mjs",
    "user:password": "node --conditions=react-server --import tsx scripts/set-password.ts",
    "staff:status": "node --conditions=react-server --import tsx scripts/staff-status.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "docx-preview": "^0.4.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.13.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "pg": "^8.13.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
